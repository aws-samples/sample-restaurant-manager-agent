# .dockerignore for the cloud-tool-relay CDK project.
# Build context is infra/cloud-tool-relay/ so paths are relative to that.

# Python virtual environments
.venv/
__pycache__/
*.pyc
*.pyo

# CDK output and caches
cdk.out/
.pytest_cache/

# Tests (not needed in container images)
tests/

# Infrastructure code (not needed in containers)
infrastructure/

# Dev requirements
requirements-dev.txt

# Git
.git/
.gitignore

# OS files
.DS_Store

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
