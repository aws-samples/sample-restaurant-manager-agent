{
  "app": ".venv/bin/python app.py",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "requirements*.txt", "**/__init__.py", "**/__pycache__", "tests"]
  },
  "context": {
    "pushSubscriptionsTableName": "PushSubscriptions",
    "vapidSecretName": "restaurant-sim/web-push/vapid",
    "vapidPublicKeyParamName": "/restaurant-sim/web-push/vapid-public-key",
    "vapidRotationDays": 60,
    "pushSubscriptionTtlDays": 90,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws", "aws-cn"],
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:enablePartitionLiterals": true
  }
}
