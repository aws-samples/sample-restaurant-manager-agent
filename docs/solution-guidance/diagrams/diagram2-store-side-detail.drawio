        <mxCell id="title" value="Store-Side Detail - the universal tool interface behind the firewall" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="16" width="880" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One outbound, mutually-authenticated connection carries both commands and responses. No inbound port is ever opened." style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="260" y="48" width="880" height="20" as="geometry" />
        </mxCell>

