            <mxPoint x="1110" y="705" as="sourcePoint" />
            <mxPoint x="1170" y="705" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg1-label" value="Request path (steps 1–6)" style="text;html=1;fontSize=10;align=left;fontColor=#0078d4;" vertex="1" parent="1">
          <mxGeometry x="1180" y="695" width="230" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg2" style="endArrow=classic;html=1;strokeColor=#245A8D;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1110" y="730" as="sourcePoint" />
            <mxPoint x="1170" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg2-label" value="Response path (steps 7–10)" style="text;html=1;fontSize=10;align=left;fontColor=#245A8D;" vertex="1" parent="1">
          <mxGeometry x="1180" y="720" width="230" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg3" style="endArrow=classic;html=1;strokeColor=#1D8102;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1110" y="755" as="sourcePoint" />
            <mxPoint x="1170" y="755" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg3-label" value="Outbound mTLS (store-initiated)" style="text;html=1;fontSize=10;align=left;fontColor=#1D8102;" vertex="1" parent="1">
          <mxGeometry x="1180" y="745" width="230" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
