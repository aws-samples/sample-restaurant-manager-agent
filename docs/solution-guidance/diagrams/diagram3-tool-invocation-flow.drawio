        <mxCell id="m7" value="7. iot-data:Publish commands/equipment (QoS 1)" style="html=1;endArrow=block;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="800" y="410" as="sourcePoint"/><mxPoint x="1040" y="410" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m8" value="8. deliver over outbound mTLS link" style="html=1;endArrow=block;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="444" as="sourcePoint"/><mxPoint x="1290" y="444" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m9" value="9. dedup + read real sensor" style="html=1;endArrow=block;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1290" y="470" as="sourcePoint"/><mxPoint x="1290" y="502" as="targetPoint"/><Array as="points"><mxPoint x="1370" y="470"/><mxPoint x="1370" y="502"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="m10" value="10. PUBLISH responses/{cid}" style="html=1;endArrow=block;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1290" y="524" as="sourcePoint"/><mxPoint x="1040" y="524" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m11" value="11. response (bounded 30s wait)" style="html=1;endArrow=open;dashed=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="558" as="sourcePoint"/><mxPoint x="800" y="558" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m12" value="12. tool result (sanitized)" style="html=1;endArrow=open;dashed=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="800" y="592" as="sourcePoint"/><mxPoint x="320" y="592" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m13" value="13. re-invoke toolUse + toolResult" style="html=1;endArrow=block;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="320" y="626" as="sourcePoint"/><mxPoint x="560" y="626" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m14" value="14. final answer (end_turn)" style="html=1;endArrow=open;dashed=1;rounded=0;fontSize=10;" edge="1" parent="1">
