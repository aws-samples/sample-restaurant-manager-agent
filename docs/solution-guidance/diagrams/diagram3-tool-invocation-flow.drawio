        </mxCell>
        <mxCell id="note1" value="background turn loop; GET /chat/result polls in-process task state" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="220" width="390" height="32" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3. invoke_harness(session, msg, inline tools)" style="html=1;endArrow=block;rounded=0;fontSize=10;" edge="1" parent="1">
