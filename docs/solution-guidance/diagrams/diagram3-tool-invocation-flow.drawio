        <!-- messages -->
        <mxCell id="m1" value="1. POST /api/chat (cooler temp?)" style="html=1;endArrow=block;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="90" y="168" as="sourcePoint"/><mxPoint x="320" y="168" as="targetPoint"/></mxGeometry>
