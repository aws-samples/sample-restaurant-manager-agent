        </mxCell>
        <mxCell id="m15" value="15. GET /chat/result -&gt; succeeded + answer" style="html=1;endArrow=open;dashed=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="320" y="694" as="sourcePoint"/><mxPoint x="90" y="694" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- timeout / offline branch -->
        <mxCell id="note2" value="Timeout / offline branch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1">
