        <mxCell id="note3" value="IoT Core queues the command (persistent session) -&gt; delivered on reconnect" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="970" y="852" width="420" height="34" as="geometry" />
        </mxCell>
        <mxCell id="note4" value="Alternative async correlation (Correlation B): gateway Lambda + CommandResults + IoT Rule -&gt; iot-response-handler resolves the durable callback and write-throughs StoreStateCache, enabling a last-known-state fallback with a staleness timestamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
