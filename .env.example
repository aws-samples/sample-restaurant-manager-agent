# MQTT bridge (optional; set MQTT_ENABLED=true to activate)
MQTT_ENABLED=false

# Broker connection
# Amazon MQ with ActiveMQ engine (primary target):
#   MQTT_BROKER_ENDPOINT=b-xxxxxxxx-1.mq.us-east-1.amazonaws.com
# AWS IoT Core (alternative):
#   MQTT_BROKER_ENDPOINT=xxxxxxxx-ats.iot.us-east-1.amazonaws.com
MQTT_BROKER_ENDPOINT=
# Broker port. Default 443: MQTT over TLS via the ALPN extension (see
# MQTT_USE_ALPN below), which reuses the outbound-HTTPS path most store
# networks already permit — no separate outbound-8883 firewall rule needed.
# For the classic MQTT-over-TLS port instead, set MQTT_BROKER_PORT=8883 (and
# MQTT_USE_ALPN=false).
MQTT_BROKER_PORT=443

# MQTT over TLS on the HTTPS port (443) using the ALPN protocol name below —
# AWS IoT Core negotiates MQTT + X.509 client-cert (mtls) auth on 443 via ALPN.
# This is the recommended default (the deployed store uses it). Set
# MQTT_USE_ALPN=false together with MQTT_BROKER_PORT=8883 for the classic 8883
# path — e.g. behind a TLS-inspecting/terminating (DPI) proxy that only passes
# real HTTP on 443 and would block ALPN-tunneled MQTT. This is a per-network choice.
MQTT_USE_ALPN=true
MQTT_ALPN_PROTOCOL=x-amzn-mqtt-ca

MQTT_KEEPALIVE_SECONDS=60

# Authentication. One of: userpass | mtls
#   userpass — default, Amazon MQ with ActiveMQ
#   mtls     — AWS IoT Core or any broker with X.509 client-cert auth
MQTT_AUTH_MODE=userpass

# Required when MQTT_AUTH_MODE=userpass
MQTT_USERNAME=simulator-store-001
MQTT_PASSWORD=

# Required when MQTT_AUTH_MODE=mtls
MQTT_CLIENT_CERT_PATH=certs/device.pem.crt
MQTT_CLIENT_KEY_PATH=certs/device.private.key

# Optional. Defaults to system trust store.
MQTT_CA_BUNDLE_PATH=

# Store identity — also used as the stable MQTT client id suffix.
STORE_ID=sim-store-001

# Resource bounds. Defaults are safe for a single-store simulator.
MQTT_DEDUP_CACHE_SIZE=1024
MQTT_DEDUP_CACHE_TTL_SECONDS=1800
MQTT_OUTBOUND_BUFFER_SIZE=256
MQTT_INBOUND_QUEUE_SIZE=64
MQTT_CONCURRENT_TOOL_LIMIT=8
MQTT_SHUTDOWN_TIMEOUT_SECONDS=5

# Supervisor Agent Chat UI (optional; requires deployed durable supervisor)
# :live alias ARN of the durable-supervisor-agent Lambda
# (spec 014 CfnOutput: SupervisorAliasArn). Example:
# arn:aws:lambda:us-west-2:123456789012:function:durable-supervisor-agent:live
SUPERVISOR_LAMBDA_ALIAS_ARN=
# AgentCore Memory ID for chat history persistence
AGENTCORE_MEMORY_ID=
# AWS region where the supervisor agent is deployed
AWS_REGION=us-west-2
